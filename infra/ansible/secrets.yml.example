# Copia este archivo a secrets.yml y completa los valores.
# secrets.yml está en .gitignore — NUNCA lo subas a git.
# Alternativa recomendada: cifrarlo con `ansible-vault encrypt secrets.yml`.

# Hash de contraseña del usuario de servicio (para sudo con contraseña).
# Generar: python3 -c "from passlib.hash import sha512_crypt; import getpass; print(sha512_crypt.hash(getpass.getpass()))"
service_user_password_hash: "CHANGEME"

# Credenciales S3/MinIO para pgBackRest
pgbackrest_s3_key: "CHANGEME"
pgbackrest_s3_key_secret: "CHANGEME"
