[Unit]
Description=Documentación de la API de ORDO
After=network.target

[Service]
Type=simple
User={{ docs_user }}
WorkingDirectory={{ docs_repo_path }}
ExecStart={{ docs_python }} {{ docs_repo_path }}/docs/landing/serve.py
Restart=on-failure
RestartSec=5

# Solo sirve archivos estáticos del repositorio: sin escritura, sin privilegios.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths={{ docs_repo_path }}

[Install]
WantedBy=multi-user.target
