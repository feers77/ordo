# Gestionado por Ansible — no editar a mano.
# TLS lo termina el edge proxy ({{ edge_proxy_ip }}); aquí solo HTTP plano.
{
	auto_https off
	servers {
		trusted_proxies static {{ edge_proxy_ip }}
	}
}

:{{ ordo_http_port }} {
	handle /healthz {
		respond "ok" 200
	}
	# Servidor MCP (ordo-mcp, compose perfil app)
	handle /mcp* {
		reverse_proxy 127.0.0.1:8001
	}
	# API genérica + meta (ordo-api, compose perfil app)
	handle {
		reverse_proxy 127.0.0.1:8000
	}
}
