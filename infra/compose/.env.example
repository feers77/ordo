# Copiar a .env y completar. .env NUNCA va a git.
POSTGRES_PASSWORD=CHANGEME
MINIO_ROOT_USER=ordoadmin
MINIO_ROOT_PASSWORD=CHANGEME
KEYCLOAK_ADMIN_PASSWORD=CHANGEME
GRAFANA_ADMIN_PASSWORD=CHANGEME
# Credenciales pgBackRest (deben coincidir con infra/ansible/secrets.yml)
PGBACKREST_S3_KEY=CHANGEME
PGBACKREST_S3_SECRET=CHANGEME
# Rol de aplicación sin BYPASSRLS (obligatorio: sin él RLS no aísla)
ORDO_APP_PASSWORD=CHANGEME
# Canal HITL de Telegram (F1-07). Sin estas claves el canal queda deshabilitado.
# El webhook secret también deriva la clave que firma los botones: rotarlo
# invalida los callbacks pendientes.
TELEGRAM_BOT_TOKEN=CHANGEME
TELEGRAM_WEBHOOK_SECRET=CHANGEME
